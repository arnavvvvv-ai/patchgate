# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Any Gemini model available to your key; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=60
# Retries apply only to 408/429/5xx/timeouts; each retry counts against PATCHGATE_MAX_LLM_CALLS
GEMINI_MAX_RETRIES=3
# Longest single backoff; 429 responses' server-suggested retryDelay is honoured up to this
GEMINI_MAX_BACKOFF_S=65
# Client-side pacing in requests/minute (0 = off). The free tier for gemini-2.5-flash allowed 5/min when tested.
GEMINI_RPM=0
PATCHGATE_MAX_LLM_CALLS=30
PATCHGATE_MAX_ATTEMPTS=3
PATCHGATE_DB=data/patchgate.db
# Mask env values, annotations and secret-looking args before sending a resource to Gemini
PATCHGATE_REDACT=true
